# Wallet credentials (Polygon/Ethereum private key)
PRIVATE_KEY=0xyour_private_key_here

# Polymarket CLOB API credentials (L2 auth)
# Generate at: https://polymarket.com (API Keys section)
API_KEY=your_api_key_here
API_SECRET=your_api_secret_here
API_PASSPHRASE=your_api_passphrase_here

# Polygon RPC endpoint (default is public endpoint)
POLYGON_RPC=https://polygon-rpc.com

# Trading parameters
# Minimum profit margin to trigger a trade (e.g. 0.02 = 2%)
MIN_PROFIT_THRESHOLD=0.02
# Maximum USDC to spend per arbitrage trade
MAX_ORDER_SIZE_USDC=50
# How often to scan for opportunities (seconds)
SCAN_INTERVAL_SECONDS=10
# Minimum market liquidity to consider (USDC open interest)
MIN_LIQUIDITY=100

# Set to true to log opportunities without placing real orders
DRY_RUN=true
